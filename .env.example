# Copy to .env.  Nothing here is required to run the server on loopback.

# --- server ---------------------------------------------------------------
# MCP_HOST=127.0.0.1
# MCP_PORT=8001
# MCP_PATH=/mcp
# SKILLS_DIR=./skills          # point at your own catalog
# MCP_LOG_LEVEL=INFO

# Bearer auth. Unset = no auth, which is fine on loopback and nowhere else.
#   MCP_TOKEN="$(openssl rand -hex 32)"
# MCP_TOKEN=

# Host/Origin allow-lists (DNS-rebinding protection). Loopback-only by default;
# name the hostname clients actually reach the server by before publishing it.
# MCP_ALLOWED_HOSTS=skills.example.com
# MCP_ALLOWED_ORIGINS=https://skills.example.com

# --- llm_router.py --------------------------------------------------------
# The only part that spends money, so it is off until you opt in.
USE_AI=false
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4.1        # set to whatever your account actually serves
# Comma-separated; add your domain servers alongside skill-router.
# MCP_URLS=http://127.0.0.1:8001/mcp
